# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Rider
*.idea

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Ignore the rider workplace xml file
.idea/.idea.ProjectEstival/.idea/workspace.xml

# FMOD plugin essentials
!Plugins/FMODStudio/
!Plugins/FMODStudio/Source/
!Plugins/FMODStudio/Content/
!Plugins/FMODStudio/*.uplugin

# Required FMOD native libraries (Windows)
!Plugins/FMODStudio/Binaries/
!Plugins/FMODStudio/Binaries/Win64/
!Plugins/FMODStudio/Binaries/Win64/fmod*.dll
!Plugins/FMODStudio/Binaries/Win64/fmod*.lib

# Ignore generated Unreal plugin binaries
Plugins/FMODStudio/Binaries/**/UnrealEditor-*.dll
Plugins/FMODStudio/Binaries/**/UnrealEditor-*.pdb

# FMOD generated banks
!Content/FMOD/
!Content/FMOD/Desktop/
!Content/FMOD/Desktop/**
**/BugReporter.ini