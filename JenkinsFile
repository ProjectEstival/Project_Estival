//test spam comments ----
def branchMap = [:]
branchMap['w0-blockout-testing'] = "blk_testing"
branchMap['develop'] = "internal_testing"
branchMap['main'] = ""

def steamBranch = "unknown"
def steamBuildId = ""
def commitMsg = "unknown"
def commitAuthor = "unknown"
def avatarUrl = ""
def gameVersion = "unknown"
def isMerge = false

def programmerRole = "<@&1506638634462351399>"

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        disableConcurrentBuilds()
        lock('project-estival-build-queue')
        skipDefaultCheckout()
        timeout(time: 3, unit: 'HOURS')
    }

    parameters {
        choice(name: 'BUILD_TYPE', choices: ['Shipping', 'Development'], description: 'Build configuration for Unreal Engine')
        string(name: 'UE_VERSION', defaultValue: '5.8', description: 'Unreal Engine Version')
        string(name: 'GITHUB_REPO_LINK', defaultValue: 'https://github.com/thanostham/Project_Estival.git', description: 'Link of Github Repository')
        string(name: 'STEAM_BRANCH', defaultValue: 'internal_testing', description: 'Branch which the build will be deployed to')
        booleanParam(name: 'PROMOTE_TO_DEFAULT', defaultValue: false, description: 'On main only: set the uploaded build live on the DEFAULT (public) branch')
        string(name: 'VERSION_MAJOR', defaultValue: '0', description: 'Major version')
        string(name: 'VERSION_MINOR', defaultValue: '0', description: 'Minor version')
    }

    environment {
        CREDS = credentials('MY_SECRET_ID')
        DISCORD_WEBHOOK_URL = credentials('PROJECT_ESTIVAL_DISCORD_WEBHOOK_BUILD_RESULT')
        ESTIVAL_DISCORD_WEBHOOK_MERGE_URL = credentials('PROJECT_ESTIVAL_DISCORD_WEBHOOK_MERGE')

        UE_BASE = "C:\\Program Files\\Epic Games"
        BUILD_DIR = "${env.WORKSPACE}\\Builds"
        UE_LOG_PATH = "C:\\Users\\PC_GAMES\\AppData\\Roaming\\Unreal Engine\\AutomationTool\\Logs\\C+Program+Files+Epic+Games+UE_${params.UE_VERSION}\\Log.txt"
        UE_UAT_PATH = "${UE_BASE}\\UE_${params.UE_VERSION}\\Engine\\Build\\BatchFiles\\RunUAT.bat"

        STEAMCMD_PATH = "C:\\Tools\\steamcmd\\steamcmd.exe"
        STEAM_APP_ID = "4383760"
        VERSION_COUNTER_DIR = "D:\\Jenkins_Home\\ProjectEstival"
        VERSION_COUNTER_FILE = "D:\\Jenkins_Home\\ProjectEstival\\build_counter.txt"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    bat "git clean -fd -e Intermediate/ -e Saved/ -e Binaries/ -e DerivedDataCache/"
                    commitMsg = bat(script: "@echo off\ngit log -1 --pretty=%%s", returnStdout: true).trim().split('\n').last()
                    commitAuthor = bat(script: "@echo off\ngit log -1 --pretty=%%an", returnStdout: true).trim().split('\n').last()
                    def parentHashes = bat(script: "@echo off\ngit log -1 --pretty=%%p", returnStdout: true).trim().split('\n').last()
                    isMerge = parentHashes.tokenize(' ').size() > 1
                    echo "Commit message: ${commitMsg}"
                    echo "Parent hashes: '${parentHashes}' (count: ${parentHashes.tokenize(' ').size()}) -> isMerge=${isMerge}"

                    def commitSha = bat(script: "@echo off\ngit rev-parse HEAD", returnStdout: true).trim().split('\n').last()
                    try {
                        withCredentials([string(credentialsId: 'GITHUB_API_TOKEN', variable: 'GITHUB_API_TOKEN')]) {
                            def commitJson = bat(returnStdout: true,
                                script: "@echo off\r\ncurl.exe -s -L -H \"Authorization: Bearer %GITHUB_API_TOKEN%\" -H \"Accept: application/vnd.github+json\" https://api.github.com/repos/thanostham/Project_Estival/commits/${commitSha}").trim()
                            def avatarMatch = (commitJson =~ /"avatar_url"\s*:\s*"([^"]+)"/)
                            if (avatarMatch) {
                                avatarUrl = avatarMatch[0][1]
                                echo "Resolved avatarUrl: ${avatarUrl}"
                            } else {
                                echo "GitHub commit API response did not contain an avatar_url: ${commitJson.take(300)}"
                            }
                        }
                    } catch (e) {
                        echo "Could not fetch commit author avatar: ${e}"
                    }
                }
            }
        }

        stage('Version') {
            steps {
                script {
                    bat "if not exist \"${VERSION_COUNTER_DIR}\" mkdir \"${VERSION_COUNTER_DIR}\""

                    def count = 0
                    if (fileExists(VERSION_COUNTER_FILE)) {
                        def raw = readFile(file: VERSION_COUNTER_FILE).trim()
                        if (raw ==~ /\d+/) {
                            count = raw.toInteger()
                        }
                    }
                    count++
                    writeFile(file: VERSION_COUNTER_FILE, text: count.toString())

                    gameVersion = "${params.VERSION_MAJOR}.${params.VERSION_MINOR}.${count.toString().padLeft(2, '0')}"
                    env.GAME_VERSION = gameVersion
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - v${gameVersion}"
                    echo "Game version: ${gameVersion}"
                }
            }
        }

        stage('Clean Up Old Build') {
            steps {
                script {
                    if (fileExists(BUILD_DIR)) {
                        echo "Removing old executable."
                        bat "rd /s /q \"${BUILD_DIR}\""
                    }
                }
            }
        }

        stage('Merge Notification') {
            when {
                allOf {
                    expression { return isMerge }
                    not { changeRequest() }
                }
            }
            steps {
                script {
                    discordSend title: "🔀 New Merge: ${env.BRANCH_NAME}",
                        description: "${programmerRole} \nSir, a merge was detected on ${env.BRANCH_NAME}. \n**Commit:** ${commitMsg}\n**Author:** ${commitAuthor}",
                        link: env.BUILD_URL,
                        result: 'ABORTED',
                        thumbnail: avatarUrl,
                        webhookURL: ESTIVAL_DISCORD_WEBHOOK_MERGE_URL
                }
            }
        }

        stage('UE Build') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'main'
                    branch 'w0-blockout-testing'
                }
            }
            steps {
                script {
                    if (!fileExists(UE_UAT_PATH)) {
                        error "RunUAT.bat not found at: ${UE_UAT_PATH}"
                    }
                }
                bat """
                "${UE_UAT_PATH}" ^
                BuildCookRun ^
                -project="${env.WORKSPACE}\\ProjectEstival.uproject" ^
                -targetplatform=Win64 ^
                -clientconfig=${params.BUILD_TYPE} ^
                -build ^
                -stage ^
                -pak ^
                -archive ^
                -archivedirectory="${BUILD_DIR}" ^
                -compresspak ^
                -closestzensnapshot=0 ^
                -cook ^
                -CookMapsOnly ^
                -utf8output
                """
                // -skipbuildeditor
            }
        }

        stage('Verify Build') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'main'
                    branch 'w0-blockout-testing'
                }
            }
            steps {
                script {
                    if (!fileExists(UE_LOG_PATH)) {
                        error "No UAT log found at ${UE_LOG_PATH} — the build likely never started."
                    }
                    def logFile = readFile(file: UE_LOG_PATH)
                    if (logFile.contains('AutomationTool exiting with ExitCode=1')) {
                        error 'Unreal Engine build reported a failure in the logs.'
                    }
                }
            }
        }

        stage('Deploy to Steam') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'main'
                    branch 'w0-blockout-testing'
                }
            }
            steps {
                script {
                    steamBranch = branchMap.get(env.BRANCH_NAME, "internal_testing")

                    def contentRoot = "${BUILD_DIR}\\Windows"
                    def outputRoot  = "${env.WORKSPACE}\\SteamOutput"

                    def vdfTemplate      = "${env.WORKSPACE}\\BuildScripts\\app_build.vdf"
                    def depotVdfTemplate = "${env.WORKSPACE}\\BuildScripts\\depot_build_4383761.vdf"

                    def genDir       = "${env.WORKSPACE}\\BuildScripts\\generated"
                    def vdfPath      = "${genDir}\\app_build.vdf"
                    def depotVdfPath = "${genDir}\\depot_build_4383761.vdf"

                    bat "if not exist \"${BUILD_DIR}\" mkdir \"${BUILD_DIR}\""
                    bat "if not exist \"${outputRoot}\" mkdir \"${outputRoot}\""
                    bat "if not exist \"${genDir}\" mkdir \"${genDir}\""

                    bat """powershell -Command "(Get-Content '${vdfTemplate}') -replace 'STEAM_BRANCH_PLACEHOLDER','${steamBranch}' -replace 'CONTENT_ROOT_PLACEHOLDER','${contentRoot}' -replace 'OUTPUT_ROOT_PLACEHOLDER','${outputRoot}' | Set-Content '${vdfPath}'" """
                    bat """powershell -Command "(Get-Content '${depotVdfTemplate}') -replace 'CONTENT_ROOT_PLACEHOLDER','${contentRoot}' -replace 'OUTPUT_ROOT_PLACEHOLDER','${outputRoot}' | Set-Content '${depotVdfPath}'" """

                    def out = bat(returnStdout: true,
                        script: "@echo off\r\n\"${STEAMCMD_PATH}\" +login %CREDS_USR% %CREDS_PSW% +run_app_build \"${vdfPath}\" +quit")
                    echo out

                    def m = (out =~ /BuildID\s+(\d+)/)
                    if (m) {
                        steamBuildId = m[0][1]
                        echo "Steam BuildID: ${steamBuildId}"
                    } else {
                        error "steamcmd did not report a BuildID — the upload did not complete."
                    }
                }
            }
        }

        stage('Promote to Default') {
            when {
                allOf {
                    branch 'main'
                    expression { return params.PROMOTE_TO_DEFAULT }
                    expression { return steamBuildId?.trim() }
                }
            }
            steps {
                withCredentials([string(credentialsId: 'PROJECT_ESTIVAL_STEAM_WEBAPI_KEY', variable: 'STEAM_WEBAPI_KEY')]) {
                    script {
                        def rc = bat(returnStatus: true, script: """
                            curl.exe -sS -f -X POST ^
                              "https://partner.steam-api.com/ISteamApps/SetAppBuildLive/v1/" ^
                              -d "key=%STEAM_WEBAPI_KEY%" ^
                              -d "appid=%STEAM_APP_ID%" ^
                              -d "buildid=${steamBuildId}" ^
                              -d "betakey=" ^
                              -d "description=Jenkins ${env.BRANCH_NAME} #${env.BUILD_NUMBER}"
                        """)
                        if (rc != 0) {
                            error "SetAppBuildLive failed (curl exit ${rc}). Build ${steamBuildId} is uploaded but NOT live."
                        }
                        echo "Build ${steamBuildId} promoted to the default branch."
                    }
                }
            }
        }

        stage('Clean Up VDF Files') {
            steps {
                script {
                    def genDir = "${env.WORKSPACE}\\BuildScripts\\generated"
                    if (fileExists(genDir)) {
                        echo "Removing generated vdf files."
                        bat "rd /s /q \"${genDir}\""
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def actionDesc = env.CHANGE_ID ? "The pipeline stages for Pull Request #${env.CHANGE_ID} were successfully completed." : "The build and the Deployment to Steam (${env.BRANCH_NAME}) were successful."

                discordSend title: "✅ Build Success: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Splendid news Sir! ${actionDesc}\n**Commit:** ${commitMsg}\n**Author:** ${commitAuthor}\n**Steam Depo:** ${steamBranch}\n**Game Version:** ${gameVersion}\n",
                    link: env.BUILD_URL,
                    result: 'SUCCESS',
                    thumbnail: avatarUrl,
                    webhookURL: DISCORD_WEBHOOK_URL
            }
        }

        aborted {
            script {
                discordSend title: "⚪ Build Aborted: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Sir, the build was aborted.\nThis is a manual operation so no commit description will be provided.",
                    link: env.BUILD_URL,
                    result: 'ABORTED',
                    webhookURL: DISCORD_WEBHOOK_URL
            }
        }

        failure {
            script {
                discordSend title: "❌ Build Failed: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Most unfortunate news Sir, the build for (${env.BRANCH_NAME}) has Failed.\n**Commit:** ${commitMsg}\n**Author:** ${commitAuthor}\n**Steam Depo:** ${steamBranch}\n**Game Version:** ${gameVersion}\n",
                    link: env.BUILD_URL,
                    result: 'FAILURE',
                    thumbnail: avatarUrl,
                    webhookURL: DISCORD_WEBHOOK_URL

                if (fileExists(UE_LOG_PATH)) {
                    echo "Dispatching the failure logs for investigation..."
                    def rc = bat(returnStatus: true,
                                 script: "curl.exe -F \"file=@${UE_LOG_PATH}\" %DISCORD_WEBHOOK_URL%")
                    if (rc != 0) {
                        echo "Log upload failed (curl exit ${rc}), carrying on regardless."
                    }
                } else {
                    echo "No UAT log to dispatch — none was written at ${UE_LOG_PATH}"
                }
            }
        }
    }
}