def branchMap = [:]
branchMap['develop'] = "internal_testing"
branchMap['main'] = "default"

def steamBranch = "unknown"
def commitMsg = "unknown"
def isMerge = false

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        disableConcurrentBuilds()
        lock ('project-anomaly-build-queue')
        skipDefaultCheckout()
    }

    parameters {
        choice(name: 'BUILD_TYPE', choices: ['Shipping', 'Development'], description: 'Build configuration for Unreal Engine')
        string(name: 'UE_VERSION', defaultValue: '5.7', description: 'Unreal Engine Version')
        string(name: 'GITHUB_REPO_LINK', defaultValue: 'https://github.com/thanostham/Project_Estival.git', description: 'Link of Github Repository')
        string(name: 'STEAM_BRANCH', defaultValue: 'internal_testing', description: 'Branch which the build will be deployed to')
    }

    environment {
        UNITY_PATH = '"C:\\Program Files\\Unity\\Hub\\Editor\\6000.3.10f1\\Editor\\Unity.exe"'
        CREDS = credentials('MY_SECRET_ID') 
        DISCORD_WEBHOOK_URL = credentials('PROJECT_ESTIVAL_DISCORD_WEBHOOK_BUILD_RESULT')
        ESTIVAL_DISCORD_WEBHOOK_MERGE_URL = credentials('PROJECT_ESTIVAL_DISCORD_WEBHOOK_MERGE')
        UE_LOG_PATH = "C:\\Users\\PC_GAMES\\AppData\\Roaming\\Unreal Engine\\AutomationTool\\Logs\\C+Program+Files+Epic+Games+UE_${params.UE_VERSION}\\Log.txt"
        UE_UAT_PATH = "${UE_BASE}\\UE_${params.UE_VERSION}\\Engine\\Build\\BatchFiles\\RunUAT.bat"
        GAME_VERSION = "0.0.${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    bat "git clean -fd -e Library/"
                    commitMsg = bat(script: "@echo off\ngit log -1 --pretty=%%s", returnStdout: true).trim().split('\n').last()
                    def parentHashes = bat(script: "@echo off\ngit log -1 --pretty=%%p", returnStdout: true).trim().split('\n').last()
                    isMerge = parentHashes.tokenize(' ').size() > 1
                }
            }
        }


        stage('Clean Up Old Build'){
            steps{
                script{
                    if (fileExists(BUILD_DIR)){
                        echo "Removing old executable."
                        bat "rd /s /q \"${BUILD_DIR}\""
                    }
                }
            }
        }

        stage('Merge Notification') {
            when {
                allOf {
                    expression { return isMerge }
                    not { changeRequest() }
                }
            }
            steps {
                script {
                    discordSend title: "🔀 New Merge: ${env.BRANCH_NAME}",
                        description: "${programmerRole} \nSir, a merge was detected on ${env.BRANCH_NAME}. \n**Commit:** ${commitMsg}",
                        link: env.BUILD_URL,
                        result: 'ABORTED',
                        webhookURL: "${env.ANOMALY_DISCORD_WEBHOOK_MERGE_URL}"
                }
            }
        }

        stage('UE Build') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'main'
                }
            }
            steps {
                bat """
                "${UE_UAT_PATH}" ^
                BuildCookRun ^
                -project="${env.WORKSPACE}\\ProjectBetrayal.uproject" ^
                -targetplatform=Win64 ^
                -clientconfig=${params.BUILD_TYPE} ^
                -serverconfig=${params.BUILD_TYPE} ^
                -build ^
                -stage ^
                -pak ^
                -archive ^
                -archivedirectory="${env.WORKSPACE}\\Builds" ^
                -compresspak ^
                -closestzensnapshot=0 ^
                -cook^
                -CookMapsOnly ^
                -utf8output
                """
            }
        }

        stage('Verify Build') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'main'
                }
            }
            steps {
                script {
                    def logFile = readFile(file: UE_LOG_PATH)
                    if (logFile.contains('Build Finished, Result: Failure')) {
                        error 'Unreal Engine build reported a failure in the logs.'
                    }
                }
            }
        }

        stage('Deploy to Steam') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'main'
                }
            }
            steps {
                script {
                    steamBranch = branchMap.get(env.BRANCH_NAME, "internal_testing")
                    def contentRoot = "${WORKSPACE}\\Builds"
                    def outputRoot = "${WORKSPACE}\\SteamOutput"
                    def vdfPath = "${WORKSPACE}\\BuildScripts\\app_build.vdf"

                    bat "if not exist Builds mkdir Builds"
                    bat "if not exist SteamOutput mkdir SteamOutput"

                    def depotVdfPath = "${WORKSPACE}\\BuildScripts\\depot_build_4383761.vdf"

                    bat """powershell -Command "(Get-Content '${vdfPath}') -replace 'STEAM_BRANCH_PLACEHOLDER','${steamBranch}' -replace 'CONTENT_ROOT_PLACEHOLDER','${contentRoot}' -replace 'OUTPUT_ROOT_PLACEHOLDER','${outputRoot}' | Set-Content '${vdfPath}'" """
                    bat """powershell -Command "(Get-Content '${depotVdfPath}') -replace 'CONTENT_ROOT_PLACEHOLDER','${contentRoot}' -replace 'OUTPUT_ROOT_PLACEHOLDER','${outputRoot}' | Set-Content '${depotVdfPath}'" """

                    bat "\"C:\\Tools\\steamcmd\\steamcmd.exe\" +login %CREDS_USR% %CREDS_PSW% +run_app_build \"${vdfPath}\" +quit"
                }
            }
        }
    }

    post {
        success {
            script {
                def actionDesc = env.CHANGE_ID ? "The pipeline stages for Pull Request #${env.CHANGE_ID} were successfully completed." : "The build and the Deployment to Steam (${env.BRANCH_NAME}) were successful."
                
                discordSend title: "✅ Build Success: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Splendid news Sir! ${actionDesc}\n**Commit:** ${commitMsg}\n**Steam Depo:** ${steamBranch}\n**Game Version:** ${env.GAME_VERSION}\n",
                    link: env.BUILD_URL,
                    result: 'SUCCESS',
                    webhookURL: "${DISCORD_WEBHOOK_URL}"
            }
        }

        aborted {
            script {
                discordSend title: "⚪ Build Aborted: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Sir, the build was aborted. ?\n This is a manual operation so no commit descreption will be provided.",
                    link: env.BUILD_URL,
                    result: 'ABORTED',
                    webhookURL: "${DISCORD_WEBHOOK_URL}"
            }
        }

        failure {
            script {
                discordSend title: "❌ Build Failed: ${env.BRANCH_NAME} (#${env.BUILD_NUMBER})",
                    description: "Most unfortunate news Sir, the build for (${env.BRANCH_NAME}) has Failed.\n**Commit:** ${commitMsg}\n**Steam Depo:** ${steamBranch}\n**Game Version:** ${env.GAME_VERSION}\n",
                    link: env.BUILD_URL,
                    result: 'FAILURE',
                    webhookURL: "${DISCORD_WEBHOOK_URL}"

                    if (fileExists(UE_LOG_PATH)) {
                    echo "Alfred: Dispatching the failure logs for investigation..."
                    bat "curl.exe -F \"file=@${UE_LOG_PATH}\" %ANOMALY_DISCORD_WEBHOOK_URL%"
                }
            }
        }
    }
}